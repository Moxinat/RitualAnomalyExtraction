{
  "id": "the_monster",
  "displayName": "The Monster",
  "model": "art/models/the_monster.bbmodel",
  "texture": "art/textures/the_monster.png",
  "tags": ["the_monster", "farm_entity"],
  "baseMovementSpeed": 4.2,
  "collisionBox": { "width": 0.8, "height": 2.2 },
  "components": [
    { "type": "MovementSpeedComponent", "baseSpeed": 4.2 },
    { "type": "PathfindingComponent", "avoidEntities": false }
  ],
  "behaviors": [
    {
      "type": "follow_patrol_path",
      "pathTag": "monster_patrol_path",
      "idleAtWaypointMs": 2000
    },
    {
      "type": "detect_player_line_of_sight",
      "range": 15.0,
      "coneAngleDeg": 70,
      "blockedByOpaque": true
    },
    {
      "type": "detect_player_proximity",
      "range": 5.0,
      "requiresLoS": false
    },
    {
      "type": "play_sound_on_state_change",
      "fromState": "*",
      "toState": "CHASE",
      "sound": "monster_growl",
      "volume": 1.0,
      "pitch": 1.0
    }
  ],
  "animations": {
    "idle":  "art/models/the_monster.bbmodel#idle",
    "walk":  "art/models/the_monster.bbmodel#walk",
    "chase": "art/models/the_monster.bbmodel#chase",
    "lunge": "art/models/the_monster.bbmodel#lunge"
  }
}
